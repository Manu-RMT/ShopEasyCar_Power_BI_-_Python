{
  "name": "Ventes Auto Clair",
  "dataColors": ["#2563EB", "#0EA5A4", "#7C3AED", "#64748B", "#059669", "#DC2626", "#9DB8F0", "#1D4ED8"],
  "background": "#FFFFFF",
  "foreground": "#0F172A",
  "tableAccent": "#2563EB",
  "good": "#059669",
  "neutral": "#64748B",
  "bad": "#DC2626",
  "maximum": "#1D4ED8",
  "center": "#9DB8F0",
  "minimum": "#E0ECFF",
  "textClasses": {
    "callout": { "fontSize": 36, "fontFace": "Segoe UI Semibold", "color": "#0F172A" },
    "title": { "fontSize": 14, "fontFace": "Segoe UI Semibold", "color": "#0F172A" },
    "header": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#5B6B82" },
    "label": { "fontSize": 11, "fontFace": "Segoe UI", "color": "#334155" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F4F6FA" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#F4F6FA" } } }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E2E8F0" } }, "radius": 16 }],
        "title": [{
          "show": true,
          "fontColor": { "solid": { "color": "#0F172A" } },
          "fontSize": 14,
          "fontFamily": "Segoe UI Semibold",
          "alignment": "left"
        }],
        "visualHeader": [{ "show": false }],
        "padding": [{ "top": 12, "bottom": 12, "left": 16, "right": 16 }],
        "dropShadow": [{ "show": false }],
        "categoryAxis": [{
          "labelColor": { "solid": { "color": "#334155" } },
          "fontSize": 11,
          "showAxisTitle": false,
          "lineColor": { "solid": { "color": "#E2E8F0" } }
        }],
        "valueAxis": [{
          "labelColor": { "solid": { "color": "#5B6B82" } },
          "fontSize": 11,
          "showAxisTitle": false,
          "gridlineColor": { "solid": { "color": "#E2E8F0" } }
        }],
        "legend": [{ "labelColor": { "solid": { "color": "#334155" } }, "fontSize": 11, "position": "Bottom" }],
        "labels": [{ "color": { "solid": { "color": "#0F172A" } }, "fontSize": 11, "labelDisplayUnits": 1 }]
      }
    },
    "card": {
      "*": {
        "title": [{ "show": false }],
        "labels": [{
          "color": { "solid": { "color": "#0F172A" } },
          "fontSize": 36,
          "fontFamily": "Segoe UI Semibold",
          "labelDisplayUnits": 1
        }],
        "categoryLabels": [{ "show": true, "color": { "solid": { "color": "#5B6B82" } }, "fontSize": 13 }]
      }
    },
    "cardVisual": {
      "*": {
        "title": [{ "show": false }],
        "value": [{
          "fontColor": { "solid": { "color": "#0F172A" } },
          "fontSize": 36,
          "fontFamily": "Segoe UI Semibold",
          "labelDisplayUnits": 1
        }],
        "label": [{ "show": true, "fontColor": { "solid": { "color": "#5B6B82" } }, "fontSize": 13 }]
      }
    },
    "slicer": {
      "*": {
        "header": [{ "show": true, "fontColor": { "solid": { "color": "#0F172A" } }, "background": { "solid": { "color": "#FFFFFF" } } }],
        "items": [{ "fontColor": { "solid": { "color": "#334155" } }, "background": { "solid": { "color": "#FFFFFF" } }, "outline": "None" }]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [{
          "fontColor": { "solid": { "color": "#0F172A" } },
          "backColor": { "solid": { "color": "#F1F5F9" } },
          "fontFamily": "Segoe UI Semibold",
          "fontSize": 12
        }],
        "values": [{
          "fontColorPrimary": { "solid": { "color": "#0F172A" } },
          "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
          "fontColorSecondary": { "solid": { "color": "#0F172A" } },
          "backColorSecondary": { "solid": { "color": "#F8FAFC" } },
          "fontSize": 12
        }],
        "grid": [{
          "gridVertical": false,
          "gridHorizontal": true,
          "gridHorizontalColor": { "solid": { "color": "#E2E8F0" } }
        }],
        "total": [{
          "fontColor": { "solid": { "color": "#0F172A" } },
          "backColor": { "solid": { "color": "#E8EEFB" } },
          "fontFamily": "Segoe UI Semibold"
        }]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [{
          "fontColor": { "solid": { "color": "#0F172A" } },
          "backColor": { "solid": { "color": "#F1F5F9" } },
          "fontFamily": "Segoe UI Semibold",
          "fontSize": 12
        }],
        "rowHeaders": [{
          "fontColor": { "solid": { "color": "#0F172A" } },
          "backColor": { "solid": { "color": "#FFFFFF" } },
          "fontSize": 12
        }],
        "values": [{
          "fontColorPrimary": { "solid": { "color": "#0F172A" } },
          "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
          "fontColorSecondary": { "solid": { "color": "#0F172A" } },
          "backColorSecondary": { "solid": { "color": "#F8FAFC" } },
          "fontSize": 12
        }],
        "grid": [{
          "gridVertical": false,
          "gridHorizontal": true,
          "gridHorizontalColor": { "solid": { "color": "#E2E8F0" } }
        }]
      }
    },
    "barChart": {
      "*": {
        "valueAxis": [{ "show": false }],
        "labels": [{ "show": true, "labelDisplayUnits": 1 }]
      }
    },
    "clusteredBarChart": {
      "*": {
        "valueAxis": [{ "show": false }],
        "labels": [{ "show": true, "labelDisplayUnits": 1 }]
      }
    },
    "columnChart": {
      "*": {
        "valueAxis": [{ "show": false }],
        "labels": [{ "show": true, "labelDisplayUnits": 1 }]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "valueAxis": [{ "show": false }],
        "labels": [{ "show": true, "labelDisplayUnits": 1 }]
      }
    },
    "lineChart": {
      "*": {
        "valueAxis": [{ "show": true, "showAxisTitle": false }],
        "labels": [{ "show": false }]
      }
    },
    "donutChart": {
      "*": {
        "legend": [{ "show": true, "position": "Right" }],
        "labels": [{ "show": true, "labelStyle": "Percent of total", "labelDisplayUnits": 1 }]
      }
    },
    "shape": {
      "*": {
        "fill": [{ "show": true, "fillColor": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "outline": [{ "show": true, "lineColor": { "solid": { "color": "#E2E8F0" } }, "weight": 1 }],
        "title": [{ "show": false }],
        "border": [{ "show": false }],
        "background": [{ "show": false }]
      }
    },
    "actionButton": {
      "*": {
        "title": [{ "show": false }],
        "border": [{ "show": false }],
        "background": [{ "show": false }]
      }
    },
    "pageNavigator": {
      "*": {
        "title": [{ "show": false }],
        "border": [{ "show": false }],
        "background": [{ "show": false }],
        "fill": [
          { "$id": "default", "show": true, "fillColor": { "solid": { "color": "#FFFFFF" } }, "transparency": 100 },
          { "$id": "hover", "show": true, "fillColor": { "solid": { "color": "#E8EEFB" } }, "transparency": 0 },
          { "$id": "selected", "show": true, "fillColor": { "solid": { "color": "#2563EB" } }, "transparency": 0 }
        ],
        "text": [
          { "$id": "default", "show": true, "fontColor": { "solid": { "color": "#334155" } }, "fontSize": 13, "fontFamily": "Segoe UI Semibold" },
          { "$id": "hover", "show": true, "fontColor": { "solid": { "color": "#0F172A" } }, "fontSize": 13, "fontFamily": "Segoe UI Semibold" },
          { "$id": "selected", "show": true, "fontColor": { "solid": { "color": "#FFFFFF" } }, "fontSize": 13, "fontFamily": "Segoe UI Semibold" }
        ]
      }
    }
  }
}
